rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check ownership of user document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: users can only read and update their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User Settings Collection: users can only manage their own settings
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Food Logs Collection: users can only access their own food logs
    match /food_logs/{logId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // Catalog Foods: Read-only for authenticated or all users, write restricted
    match /foods/{foodId} {
      allow read: if true;
      allow write: if false;
    }

    // Food Categories: Read-only
    match /food_categories/{catId} {
      allow read: if true;
      allow write: if false;
    }

    // Educational Contents: Read-only
    match /educational_contents/{contentId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
